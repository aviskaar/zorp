{
  "name": "zorp-web-ui",
  "version": "0.1.0",
  "private": true,
  "description": "Static chat UI for the zorp agent.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "esbuild src/main.ts --bundle --format=iife --target=es2020 --outfile=dist/main.js",
    "build:min": "npm run build -- --minify --sourcemap",
    "watch": "npm run build -- --watch",
    "serve": "npm run build -- --servedir=. --watch",
    "check": "tsc --noEmit"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "typescript": "^5.6.0"
  }
}
